# ─────────────────────────────────────────────────────────────
# Pulso — variables de entorno. Copia este archivo a .env.local y
# rellena los valores. NUNCA subas .env.local a git.
# v1 funciona SIN ninguna de estas claves (modo mock). Ve agregándolas
# para activar servicios reales.
# ─────────────────────────────────────────────────────────────

# URL pública de la app (para enlaces en correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin (SOLO DEMO) ──
# En producción reemplazar por rol real con hash + MFA.
ADMIN_EMAIL=admin@pulso.com
ADMIN_PASSWORD_PLAIN=12341234

# ── Resend (correos de alerta e invitación) — v1 ──
# Sin esta clave, los correos se registran en consola (modo mock).
RESEND_API_KEY=
RESEND_FROM=Pulso <onboarding@resend.dev>

# ── Supabase (persistencia) — v1 ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Pollar (auth OTP + wallet embebida) — v1 ──
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=

# ── Cifrado de datos sensibles ──
DATA_ENCRYPTION_KEY=

# ── Stellar (anclaje de incidentes) ──
# Sin STELLAR_CONTRACT_ID + STELLAR_SERVICE_SECRET, el anclaje se omite (no-op).
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_ID=
STELLAR_SERVICE_SECRET=

# ── v2 (IA / lugares) ──
GROQ_API_KEY=
GOOGLE_PLACES_API_KEY=
